[gd_resource type="Resource" script_class="ChapterManifest" load_steps=2 format=3]

[ext_resource type="Script" path="res://core/chapter_manifest.gd" id="1"]

[resource]
script = ExtResource("1")
id = "fall"
content_version = 2
title = "序章 · 下坠"
rooms = [{"id": "classroom", "title": "01 / 无声教室", "subtitle": "钟声响起之前，先学会提出一个问题。", "color": "#263b3e", "objects": [{"id": "lin", "title": "林同学", "kind": "npc", "x": 176, "y": 136, "texts": ["你也听到了同一声钟响？老师说，一切都能用课本解释。可纸片总是迟到。", "我看见另一个你按下了开关。我们一起做过这个实验吗？", "如果答案会带来惩罚，你还会把它写下来吗？"]}, {"id": "switch_a", "title": "走廊联锁 A", "kind": "switch", "x": 432, "y": 136}, {"id": "syllabus", "title": "课程公告", "kind": "board", "x": 320, "y": 96, "text": "本日许可：观察、控制变量、基础模型。\n任何结论都必须记录条件。高级知识不自动等于正确答案。\n联锁 A 与器材室 B 同时接通后，实验室可进入。"}, {"id": "to_corridor_1", "title": "去走廊", "kind": "exit", "x": 320, "y": 288, "target": "corridor"}]}, {"id": "corridor", "title": "02 / 回声走廊", "subtitle": "你经过的每一处，都可能成为后来的线索。", "color": "#273841", "objects": [{"id": "to_classroom", "title": "教室", "kind": "exit", "x": 80, "y": 192, "target": "classroom"}, {"id": "to_lab", "title": "实验室 · 联锁门", "kind": "exit", "x": 320, "y": 96, "target": "lab", "requires": "lab_gate"}, {"id": "to_storage", "title": "器材室", "kind": "exit", "x": 560, "y": 192, "target": "storage"}, {"id": "to_tower", "title": "观测塔", "kind": "exit", "x": 224, "y": 288, "target": "tower"}, {"id": "to_archive", "title": "封锁档案室", "kind": "exit", "x": 432, "y": 288, "target": "archive", "requires": "drag"}, {"id": "caretaker", "title": "值班员", "kind": "npc", "x": 400, "y": 192, "texts": ["把两边的开关保持接通。不要追逐回声，它们只是过去的记录。", "我记得你拿过那份器材。回声不会再拿走这一轮的东西。", "档案室的门已经开了。选择留下什么记录，是你的事。"]}, {"id":"fall_gate","title":"落体闸门 · 释放并观察窗口","kind":"gate","x":224,"y":256}]}, {"id": "storage", "title": "03 / 器材室", "subtitle": "工具会被重置，理解会留下。", "color": "#3d3831", "objects": [{"id": "kit", "title": "实验包", "kind": "pickup", "x": 160, "y": 128}, {"id": "switch_b", "title": "走廊联锁 B", "kind": "switch", "x": 448, "y": 128}, {"id": "pump", "title": "真空泵", "kind": "switch", "x": 432, "y": 232}, {"id": "crate", "title": "可移动器材箱", "kind": "crate", "x": 224, "y": 208}, {"id": "storage_note", "title": "操作手册", "kind": "board", "x": 320, "y": 96, "text": "实验包：球、纸、释放架与计时器。\n真空对照需要先启动泵。\n箱子每轮可推动一次；如果历史中的自己再次推它，会出现因果偏差。"}, {"id": "to_corridor_2", "title": "去走廊", "kind": "exit", "x": 80, "y": 256, "target": "corridor"}]}, {"id": "lab", "title": "04 / 落体实验室", "subtitle": "同一个现象，需要能经受反例的解释。", "color": "#234247", "objects": [{"id":"assist_a","title":"稳压工位 A · 维持12秒","kind":"hold","x":144,"y":144}, {"id":"assist_b","title":"安全锁 B · 维持12秒","kind":"hold","x":464,"y":144}, {"id":"rig_power","title":"实验供电 · 因果干预","kind":"switch","x":560,"y":240}, {"id": "lab_drop", "title": "释放架 / 进入实验", "kind": "experiment", "x": 304, "y": 152}, {"id": "researcher", "title": "研究助理", "kind": "npc", "x": 480, "y": 192, "texts": ["先看，再猜。观察到球先落地，还不能断言原因就是质量。", "让两球从同样高度静止释放。你的比较条件够公平吗？", "先让纸片改变形状，再做真空对照。能同时解释两组数据的模型才算合格。"]}, {"id": "compression", "title": "已理解流程 / 压缩", "kind": "compression", "x": 160, "y": 224}, {"id": "to_corridor_3", "title": "回走廊", "kind": "exit", "x": 320, "y": 288, "target": "corridor"}]}, {"id": "tower", "title": "05 / 观测塔", "subtitle": "世界重置之后，谁会记得你的行动？", "color": "#343449", "objects": [{"id": "cycle_console", "title": "记录终端 / 下一轮", "kind": "cycle", "x": 320, "y": 144}, {"id": "archivist", "title": "档案员", "kind": "npc", "x": 464, "y": 224, "texts": ["记录结束后，学校会恢复原样。你的知识和行动历史不会消失。", "回声按照世界时间行动。交谈和论证时，所有回声都会等待。", "你已经拥有两份历史。用现在的选择，写下第三份。"]}, {"id": "echo_guide", "title": "回声说明", "kind": "board", "x": 160, "y": 128, "text": "回声会在所有区域重现真实路线。\n开门、开关、推箱与实验影响当前环境；对话和拾取只重现。\n历史动作不符合当前状态时会标记偏差，不会强行覆盖你。\n等待可以加速，也可以从最近检查点重新尝试。"}, {"id": "to_corridor_4", "title": "去走廊", "kind": "exit", "x": 320, "y": 288, "target": "corridor"}]}, {"id": "archive", "title": "06 / 封锁档案室", "subtitle": "理解没有边界，许可却有。", "color": "#433638", "objects": [{"id": "future_terminal", "title": "未授权档案 / 最终选择", "kind": "finale", "x": 320, "y": 160}, {"id": "archive_note", "title": "一封未寄出的信", "kind": "board", "x": 176, "y": 224, "text": "如果某个公式失效，先检查它的条件。\n如果某条规则不许你检查条件，先记住这个疑问。\n—— 留给下一次来到这里的我"}, {"id": "to_corridor_5", "title": "回走廊", "kind": "exit", "x": 320, "y": 288, "target": "corridor"}]}]
card_ids = PackedStringArray("observe", "experiment", "weight", "gravity", "control", "measurement", "repeat", "rebuttal", "shape", "vacuum", "drag", "domain", "future")
knowledge_ids = PackedStringArray("observation", "gravity", "drag", "future")
